PORT=3000
JWT_SECRET=change-me
DEV_AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DITTO_HTTP_URL=http://localhost:8080
DITTO_WS_URL=ws://localhost:8080/ws/2
DITTO_USERNAME=ditto
DITTO_PASSWORD=ditto
TWIN_SYNC_ENABLED=true
DITTO_BOOTSTRAP_TIMEOUT_MS=5000
STALE_THRESHOLD_MS=2000

# 009 — optional first platform admin (empty user store only; not used in test runs)
# BOOTSTRAP_ADMIN_EMAIL=admin@company.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Default Ditto policy id for elevator Things created via POST /api/v1/buildings/:id/elevators/things
DEFAULT_ELEVATOR_POLICY_ID=org.example:l72-elevator-policy

# API v1 rate limits (per IP, fixed 60s window). Disabled automatically when NODE_ENV=test.
# API_RATE_LIMIT_DISABLED=true
# API_V1_LOGIN_RPM=30
# API_V1_PROVISION_RPM=120
